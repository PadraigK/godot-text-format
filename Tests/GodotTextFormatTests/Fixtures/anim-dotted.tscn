[gd_scene format=3]

[sub_resource type="Animation" id="Animation_reset"]
length = 0.1

[sub_resource type="Animation" id="Animation_title"]
resource_name = "title"
length = 2.5

[sub_resource type="AnimationLibrary" id="AnimationLibrary_default"]
_data = {
&"RESET": SubResource("Animation_reset"),
&"title": SubResource("Animation_title")
}

[sub_resource type="AnimationLibrary" id="AnimationLibrary_enemy"]
_data = {
&"attack": SubResource("Animation_title")
}

[node name="Main" type="Node2D"]

[node name="AnimationPlayer" type="AnimationPlayer" parent="."]
libraries/ = SubResource("AnimationLibrary_default")
libraries/enemy = SubResource("AnimationLibrary_enemy")
